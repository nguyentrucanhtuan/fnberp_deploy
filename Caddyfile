# ─────────────────────────────────────────────────────────────────────────
# TRCF ERP — reverse proxy (Caddy)
#
# Gộp frontend + backend về MỘT cổng duy nhất (80, hoặc 443 khi có domain):
#   • /socket.io/*   → backend  (WebSocket màn bếp + màn khách — 045)
#   • /shop/*        → backend  (BFF công khai cho Zalo Mini App — 046)
#   • /bridge/*      → backend  (TRCF Bridge — cầu nối thiết bị ở máy quầy, 047)
#   • còn lại        → frontend (Next.js; API quản trị đi qua BFF /api có RBAC)
#
# Nhờ gộp một origin, trình duyệt trên tablet/điện thoại trong LAN chỉ cần biết
# ĐÚNG MỘT địa chỉ — không phải cấu hình IP backend riêng, không dính CORS.
#
# SITE_ADDRESS (đặt trong .env):
#   :80              → HTTP thuần, dùng trong mạng nội bộ (mặc định)
#   erp.quan.vn      → Caddy TỰ xin + gia hạn chứng chỉ HTTPS (Let's Encrypt)
# ─────────────────────────────────────────────────────────────────────────

{
	admin off
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	# Kênh real-time + BFF công khai + cầu nối thiết bị ở quầy → backend NestJS
	#
	# `/bridge/*` (047) BẮT BUỘC có mặt ở đây: TRCF Bridge chạy trên MÁY THẬT
	# (ngoài Docker, vì container không chạm được cổng USB), nên nó chỉ vào được backend
	# qua cổng 80 này — docker-compose cố ý KHÔNG mở cổng 3333 ra máy. Thiếu dòng này thì
	# mọi lời gọi của nó rơi vào Next.js và nhận 404: máy in USB im lặng không in, mà
	# nhìn màn hình chỉ thấy lệnh in nằm chờ. (Trước 2026-08-06 đường này tên
	# `/print-agent/*`; đổi cùng lúc với việc đổi tên chương trình.)
	#
	# Đường này tự xác thực bằng token riêng của agent (`AgentTokenGuard`), không đi qua
	# RBAC — cùng mức phơi ra như `/shop/*`. Riêng bước ghép mã bị chặn 5 lần/phút.
	@backend path /socket.io/* /shop/* /bridge/*
	handle @backend {
		# Không đặt timeout: agent giữ mỗi lượt hỏi việc tới 25 giây (long-poll) để tờ
		# bill ra gần như tức thì. Cắt sớm hơn là nó phải hỏi lại liên tục.
		reverse_proxy backend:3333
	}

	# Toàn bộ giao diện + BFF proxy /api (đã gắn Bearer, RBAC ở backend)
	handle {
		reverse_proxy frontend:3000
	}

	# Log gọn, giữ 3 file × 10MB
	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 3
		}
		format console
	}
}
