# ═══════════════════════════════════════════════════════════════════════
# TRCF ERP — cấu hình
#
# BÌNH THƯỜNG BẠN KHÔNG CẦN ĐỘNG VÀO FILE NÀY: script cài đặt
# (install/ubuntu.sh) tự sinh .env với mật khẩu + khoá bí mật ngẫu nhiên.
#
# File này chỉ để tham khảo / cài thủ công:
#   cp .env.example .env  →  điền giá trị  →  docker compose up -d
#   Sinh khoá:  openssl rand -hex 32   (mỗi khoá một giá trị RIÊNG)
# ═══════════════════════════════════════════════════════════════════════

# ── Truy cập ───────────────────────────────────────────────────────────
# SITE_ADDRESS = địa chỉ Caddy lắng nghe:
#   :80            → HTTP trong mạng nội bộ (mặc định; máy khác cùng wifi vào
#                    bằng http://<IP-máy-chủ>)
#   erp.quan.vn    → domain thật; Caddy TỰ xin + gia hạn HTTPS miễn phí
#                    (phải trỏ DNS về IP máy chủ và mở cổng 80/443 trước)
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443
# Địa chỉ công khai — dùng cho link trong email đặt lại mật khẩu
APP_URL=http://localhost
# Gốc URL của ảnh sản phẩm. ĐỂ RỖNG (khuyến nghị) = ảnh dùng đường dẫn tương đối
# `/uploads/...`, nên xem ERP bằng địa chỉ nào cũng thấy ảnh: IP LAN ở quầy,
# domain/tunnel khi xem từ xa, IP Tailscale lúc hỗ trợ. Điền một địa chỉ cố định
# vào đây thì ảnh CHỈ hiện với máy tới được đúng địa chỉ đó.
# Chỉ điền khi ảnh nằm ở nơi khác thật (CDN/R2), ví dụ https://cdn.quan.vn
UPLOADS_BASE_URL=

# ── Phiên bản ảnh ──────────────────────────────────────────────────────
# latest = luôn lấy bản mới nhất. Ghim phiên bản: đổi thành tag cụ thể.
IMAGE_TAG=latest

# ── Database (Postgres chạy trong Docker — KHÔNG cần DB ngoài) ──────────
# Dữ liệu nằm ở volume "pgdata". Dùng chuỗi hex để tránh ký tự đặc biệt phá URL.
DB_USER=trcf
DB_NAME=trcf_erp
DB_PASSWORD=thay-bang-openssl-rand-hex-24

# ── Khoá bí mật (BẮT BUỘC — mỗi máy một giá trị riêng) ──────────────────
JWT_SECRET=thay-bang-openssl-rand-hex-32
JWT_EXPIRES=8h
AUTH_SECRET=thay-bang-openssl-rand-hex-32

# ── Tài khoản quản trị đầu tiên (tạo tự động lần chạy đầu) ──────────────
ADMIN_SEED_EMAIL=admin@trcf.vn
ADMIN_SEED_PASSWORD=thay-mat-khau-manh

# ── Email (tuỳ chọn — 'log' = chỉ in ra log, không gửi thật) ────────────
MAIL_DRIVER=log
MAIL_FROM=onboarding@resend.dev
RESEND_API_KEY=

# ── AI marketing (tuỳ chọn — để trống thì tắt tính năng sinh nội dung) ──
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Zalo Mini App (tuỳ chọn — giải mã SĐT khách đặt online) ─────────────
ZALO_APP_SECRET=
