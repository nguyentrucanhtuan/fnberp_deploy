# ═══════════════════════════════════════════════════════════════
# TRCF ERP — cấu hình cho bản giao khách (docker compose)
# Dùng: cp .env.example .env  →  điền giá trị thật  →  docker compose up -d
# Sinh secret: openssl rand -hex 32   (mỗi khoá một giá trị RIÊNG)
# ═══════════════════════════════════════════════════════════════

# ── Cổng publish ra host ──
BACKEND_PORT=3333
FRONTEND_PORT=3000

# ── Database — Postgres chạy bằng Docker trong stack này (KHÔNG cần Neon) ──
# Chỉ đặt MẬT KHẨU DB; DATABASE_URL do docker-compose.yml tự dựng từ đây.
# Nên dùng chuỗi hex/chữ-số (openssl rand -hex 24) để tránh ký tự đặc biệt phá URL.
DB_PASSWORD=thay-mat-khau-db-manh
# (tuỳ chọn) đổi user / tên DB:
# DB_USER=trcf
# DB_NAME=trcf_erp

# ── Auth/RBAC (BẮT BUỘC) ──
JWT_SECRET=thay-bang-openssl-rand-hex-32
JWT_EXPIRES=8h
ADMIN_SEED_EMAIL=admin@trcf.vn
ADMIN_SEED_PASSWORD=thay-mat-khau-manh
APP_URL=http://localhost:3000

# ── NextAuth (BẮT BUỘC) ──
AUTH_SECRET=thay-bang-openssl-rand-hex-32

# ── Email (tuỳ chọn — mặc định 'log' in ra console) ──
MAIL_DRIVER=log
MAIL_FROM=onboarding@resend.dev
RESEND_API_KEY=

# ── LLM marketing (tuỳ chọn) ──
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Zalo Mini App (tuỳ chọn) ──
ZALO_APP_SECRET=
